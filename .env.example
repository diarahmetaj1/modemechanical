# Copy to .env and fill in. Never commit .env.
# Endpoint that receives contact form submissions (JSON POST).
PUBLIC_FORM_ENDPOINT=YOUR_FORM_ENDPOINT
# Optional: external booking page. Leave empty to keep buttons pointing to /contact/.
PUBLIC_BOOKING_URL=
# Google tag ID from the current site's HTML.
PUBLIC_GTAG_ID=YOUR_GTAG_ID

# ---- Website assistant (see ASSISTANT.md) ----
# The "Ask a question" chat assistant (off by default). Free mode answers from the site's pages, no AI, no cost.
# Set to true to show it. PUBLIC_ASSISTANT_MODE=ai switches to AI answers (needs one of the keys below).
PUBLIC_ASSISTANT_ENABLED=false
PUBLIC_ASSISTANT_MODE=site
# AI mode only. Server-side: never prefix with PUBLIC_. Set keys in the host's dashboard, not in git.
# Free: Google Gemini key from Google AI Studio (aistudio.google.com). Used first when set.
GEMINI_API_KEY=YOUR_API_KEY
# Paid alternative: Anthropic Claude key.
ANTHROPIC_API_KEY=YOUR_API_KEY
# Optional. Defaults: gemini-flash-lite-latest (Gemini) or claude-haiku-5-5 (Claude); effort low (Claude only).
ASSISTANT_MODEL=
ASSISTANT_EFFORT=
# Optional budgets. Defaults: 12 per visitor per 10 minutes, 60 per visitor per day, 2000 per day in total.
ASSISTANT_LIMIT_PER_CLIENT_10MIN=
ASSISTANT_LIMIT_PER_CLIENT_DAY=
ASSISTANT_LIMIT_GLOBAL_DAY=
# Optional. Random string used to anonymise visitor IP addresses for rate limiting.
ASSISTANT_HASH_SALT=YOUR_SECRET
# Optional. Shared rate limits across server instances (Upstash Redis REST API).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=YOUR_TOKEN
# Local development only: answer with scripted replies, no API key or cost.
# ASSISTANT_PROVIDER=mock

# ---- Contact form: EmailJS (see README, "Contact form") ----
# Public by design (used in the browser); restrict your domain in the EmailJS dashboard.
PUBLIC_EMAILJS_SERVICE_ID=YOUR_SERVICE_ID
PUBLIC_EMAILJS_TEMPLATE_ID=YOUR_TEMPLATE_ID
PUBLIC_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY
