# Copy to .env and fill in. Never commit .env.
# Endpoint that receives contact form submissions (JSON POST).
PUBLIC_FORM_ENDPOINT=YOUR_FORM_ENDPOINT
# Optional: external booking page. Leave empty to keep buttons pointing to /contact/.
PUBLIC_BOOKING_URL=
# Google tag ID from the current site's HTML.
PUBLIC_GTAG_ID=YOUR_GTAG_ID

# ---- Website assistant (see ASSISTANT.md) ----
# The "Ask a question" assistant. Free by default: answers from the site's pages, no AI, no cost.
# Set to false to hide it. PUBLIC_ASSISTANT_MODE=ai switches to paid AI answers (needs the key below).
PUBLIC_ASSISTANT_ENABLED=true
PUBLIC_ASSISTANT_MODE=site
# AI mode only (paid). Server-side: never prefix with PUBLIC_. Set it in the host's dashboard, not in git.
ANTHROPIC_API_KEY=YOUR_API_KEY
# Optional. Defaults: claude-haiku-5-5, low.
ASSISTANT_MODEL=
ASSISTANT_EFFORT=
# Optional budgets. Defaults: 12 per visitor per 10 minutes, 60 per visitor per day, 2000 per day in total.
ASSISTANT_LIMIT_PER_CLIENT_10MIN=
ASSISTANT_LIMIT_PER_CLIENT_DAY=
ASSISTANT_LIMIT_GLOBAL_DAY=
# Optional. Random string used to anonymise visitor IP addresses for rate limiting.
ASSISTANT_HASH_SALT=YOUR_SECRET
# Optional. Shared rate limits across server instances (Upstash Redis REST API).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=YOUR_TOKEN
# Local development only: answer with scripted replies, no API key or cost.
# ASSISTANT_PROVIDER=mock
