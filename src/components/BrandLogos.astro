---
// Brand logos, two layouts:
// - slider (default): one row that scrolls in a continuous loop; it pauses on hover and stays
//   still (wrapped into rows) for visitors who ask for reduced motion.
// - grid (slider={false}): the logos as a wrapped grid of boxes.
import { brands } from '../data/brands';
interface Props { title?: string; boxed?: boolean; slider?: boolean }
const { title = 'Brands We Work With', boxed = false, slider = true } = Astro.props;
---
<div class:list={["brands", { "brands--boxed": boxed, "brands--grid": !slider }]} data-reveal="fade-up">
  {title && <h2 class="brands__title">{title}</h2>}
  {slider ? (
    <div class="marquee" style={`--count:${brands.length}`}>
      <div class="marquee__track">
        <ul aria-label="HVAC brands we install and service">
          {brands.map((b) => (
            <li><img src={b.src} alt={b.alt} width="360" height="144" loading="lazy" decoding="async" draggable="false" /></li>
          ))}
        </ul>
        {/* Second copy makes the loop seamless; it is hidden from screen readers. */}
        <ul class="marquee__copy" aria-hidden="true">
          {brands.map((b) => (
            <li><img src={b.src} alt="" width="360" height="144" loading="lazy" decoding="async" draggable="false" /></li>
          ))}
        </ul>
      </div>
    </div>
  ) : (
    <ul class="grid">
      {brands.map((b) => (
        <li><img src={b.src} alt={b.alt} width="360" height="144" loading="lazy" decoding="async" /></li>
      ))}
    </ul>
  )}
</div>
<style>
  .brands__title { font-size: 1.25rem; text-align: center; margin-bottom: 24px; }
  .brands--boxed { background: var(--blue-800); border-radius: var(--radius-lg); padding: clamp(28px, 5vw, 48px); }
  .brands--boxed .brands__title { color: #fff; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { border-radius: var(--radius-md); background: var(--surface); display: grid; place-items: center; }
  /* Every logo file shares one 360x144 canvas with its mark already sized, so one box fits all. */
  img { width: 100%; height: auto; user-select: none; -webkit-user-drag: none; }

  /* Slider: two identical rows side by side move left by exactly one row's width, then repeat. */
  .marquee {
    --item: 160px; --gap: 14px; --duration: calc(var(--count) * 4s);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 48px, #000 calc(100% - 48px), transparent);
    mask-image: linear-gradient(90deg, transparent, #000 48px, #000 calc(100% - 48px), transparent);
  }
  .marquee__track { display: flex; width: max-content; animation: marquee var(--duration) linear infinite; }
  .marquee:hover .marquee__track { animation-play-state: paused; }
  .marquee ul { display: flex; gap: var(--gap); padding-right: var(--gap); }
  .marquee li { flex: none; width: var(--item); height: 96px; padding: 12px 10px; }
  .marquee img { max-width: 150px; }
  @keyframes marquee { to { transform: translateX(-50%); } }

  /* Grid. */
  .grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; }
  .grid li { width: 152px; height: 100px; padding: 12px 10px; }
  .grid img { max-width: 160px; }

  @media (max-width: 560px) {
    .marquee { --item: 128px; --gap: 12px; }
    .marquee li { height: 80px; padding: 10px 8px; }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .grid li { width: auto; height: 88px; padding: 14px; }
  }
  /* Reduced motion: no movement; the single row wraps into centered rows instead. */
  @media (prefers-reduced-motion: reduce) {
    .marquee { -webkit-mask-image: none; mask-image: none; }
    .marquee__track { animation: none; width: auto; }
    .marquee__copy { display: none; }
    .marquee ul { flex-wrap: wrap; justify-content: center; padding-right: 0; }
  }
</style>
