---
// Brand logos as a compact horizontal slider: swipe on touch screens, arrows on larger screens,
// and a gentle autoplay that stops for good once the visitor interacts. Without JavaScript the
// row is still a native, swipeable scroll strip.
import { brands } from '../data/brands';
interface Props { title?: string; boxed?: boolean }
const { title = 'Brands We Work With', boxed = false } = Astro.props;
---
<div class:list={["brands", { "brands--boxed": boxed }]} data-reveal="fade-up">
  {title && <h2 class="brands__title">{title}</h2>}
  <div class="logos" data-logo-slider data-at-start>
    <button type="button" class="logos__btn logos__btn--prev" aria-label="Previous brands" data-dir="-1">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
    </button>
    <ul class="logos__track" aria-label="HVAC brands we install and service" tabindex="0">
      {brands.map((b) => (
        <li><img src={b.src} alt={b.alt} width="360" height="144" loading="lazy" decoding="async" draggable="false" /></li>
      ))}
    </ul>
    <button type="button" class="logos__btn logos__btn--next" aria-label="Next brands" data-dir="1">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
    </button>
  </div>
</div>
<script>
  const AUTOPLAY_MS = 3500;
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-logo-slider]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.logos__track');
    if (!track) return;
    const step = () => {
      const item = track.querySelector('li');
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return item ? item.getBoundingClientRect().width + gap : track.clientWidth;
    };
    const atEnd = () => track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;

    // Arrow state and edge fades follow the scroll position.
    const sync = () => {
      root.toggleAttribute('data-at-start', track.scrollLeft <= 2);
      root.toggleAttribute('data-at-end', atEnd());
      root.toggleAttribute('data-static', track.scrollWidth <= track.clientWidth + 2);
    };
    track.addEventListener('scroll', sync, { passive: true });
    new ResizeObserver(sync).observe(track);
    sync();

    root.querySelectorAll<HTMLButtonElement>('.logos__btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        stop();
        track.scrollBy({ left: Number(btn.dataset.dir) * step(), behavior: 'smooth' });
      });
    });

    // Autoplay: one logo at a time, back to the start at the end. It stops for good on any
    // interaction, and only runs while the slider is on screen and the tab is visible.
    let timer = 0;
    let stopped = reduceMotion;
    let visible = false;
    let hovered = false;
    const tick = () => {
      if (stopped || !visible || hovered || document.hidden) return;
      track.scrollTo({ left: atEnd() ? 0 : track.scrollLeft + step(), behavior: 'smooth' });
    };
    const start = () => { if (!timer && !stopped) timer = window.setInterval(tick, AUTOPLAY_MS); };
    function stop() { stopped = true; window.clearInterval(timer); timer = 0; }
    root.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') hovered = true; });
    root.addEventListener('pointerleave', () => { hovered = false; });
    track.addEventListener('pointerdown', stop);
    track.addEventListener('wheel', (e) => { if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) stop(); }, { passive: true });
    root.addEventListener('focusin', stop);
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; if (visible) start(); }).observe(root);
  });
</script>
<style>
  .brands__title { font-size: 1.25rem; text-align: center; margin-bottom: 20px; }
  .brands--boxed { background: var(--blue-800); border-radius: var(--radius-lg); padding: clamp(24px, 4vw, 40px); }
  .brands--boxed .brands__title { color: #fff; }

  /* How many logos show at once follows the slider's own width; fractions leave a peek of the next one. */
  .logos { --gap: 12px; --n: 2.4; container-type: inline-size; position: relative; }
  .logos__track {
    list-style: none; margin: 0; padding: 2px 0; display: flex; gap: var(--gap);
    overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scroll-behavior: smooth;
    scrollbar-width: none; -webkit-overflow-scrolling: touch;
    /* Soft fade at the edges that still have logos beyond them. */
    --fade-l: 0px; --fade-r: 40px;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 var(--fade-l), #000 calc(100% - var(--fade-r)), transparent);
    mask-image: linear-gradient(90deg, transparent, #000 var(--fade-l), #000 calc(100% - var(--fade-r)), transparent);
  }
  .logos__track::-webkit-scrollbar { display: none; }
  .logos__track:focus-visible { outline-offset: 4px; border-radius: var(--radius-md); }
  .logos:not([data-at-start]) .logos__track { --fade-l: 40px; }
  .logos[data-at-end] .logos__track { --fade-r: 0px; }
  .logos[data-static] .logos__track { -webkit-mask-image: none; mask-image: none; justify-content: center; }

  li {
    flex: 0 0 calc((100% - (var(--n) - 1) * var(--gap)) / var(--n)); scroll-snap-align: start;
    height: 92px; border-radius: var(--radius-md); background: var(--surface);
    display: grid; place-items: center; padding: 10px 12px;
  }
  .brands--boxed li { background: #fff; }
  /* Every logo file shares one 360x144 canvas with its mark already sized, so one box fits all. */
  img { width: 100%; height: auto; max-width: 150px; user-select: none; -webkit-user-drag: none; }

  .logos__btn {
    position: absolute; top: 50%; z-index: 1; display: none; place-items: center; width: 40px; height: 40px;
    border: 0; border-radius: 50%; cursor: pointer; transform: translateY(-50%);
    background: #fff; color: var(--ink); box-shadow: 0 6px 18px -8px rgba(14,34,56,.45), inset 0 0 0 1px var(--line);
    transition: opacity .2s ease, background-color .2s ease, color .2s ease;
  }
  .logos__btn:hover { background: var(--ink); color: #fff; }
  .logos__btn--prev { left: -6px; }
  .logos__btn--next { right: -6px; }
  .logos[data-at-start] .logos__btn--prev, .logos[data-at-end] .logos__btn--next { opacity: 0; pointer-events: none; }
  .logos[data-static] .logos__btn { display: none !important; }

  @container (min-width: 480px) { .logos__track { --n: 3.5; } }
  @container (min-width: 640px) { .logos__track, .logos__track li { --n: 4; } .logos__btn { display: grid; } }
  @container (min-width: 900px) { .logos__track, .logos__track li { --n: 5; } }
  @container (min-width: 1100px) { .logos__track, .logos__track li { --n: 6; } }
  @media (prefers-reduced-motion: reduce) { .logos__track { scroll-behavior: auto; } }
</style>
