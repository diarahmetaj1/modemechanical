---
// Responsive photo: AVIF first, then WebP, then the original format, at several widths, built at
// compile time by Astro's image service (sharp). Lazy by default; pass loading="eager" for
// images at the top of the page. Other attributes (class, data-reveal, …) go to the <img>.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Rendered widths to generate; anything wider than the source is dropped. */
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  [attr: string]: unknown;
}
const { src, alt, widths = [400, 800, 1200], sizes = '100vw', loading = 'lazy', ...attrs } = Astro.props;
const usable = widths.filter((w) => w < src.width);
const finalWidths = [...usable, Math.min(src.width, Math.max(...widths))];
---
<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  widths={finalWidths}
  sizes={sizes}
  loading={loading}
  decoding="async"
  {...attrs}
/>
