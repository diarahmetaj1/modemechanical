---
// Responsive photo: AVIF first, then WebP, then the original format (JPEG for photos, PNG for
// logos so transparency survives), at several widths, built at compile time by Astro's image
// service (sharp). Quality per format: src/lib/image-quality.ts. Lazy by default; pass
// loading="eager" for images at the top of the page. Other attributes (class, data-reveal, …) go
// to the <img>.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { IMAGE_QUALITY } from '../lib/image-quality';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Rendered widths to generate; anything wider than the source is dropped. */
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  [attr: string]: unknown;
}
const { src, alt, widths = [400, 640, 720, 800, 1200], sizes = '100vw', loading = 'lazy', ...attrs } = Astro.props;
const finalWidths = [...widths.filter((w) => w < src.width), Math.min(src.width, Math.max(...widths))];
const isPhoto = src.format === 'jpg' || src.format === 'jpeg';
const q = isPhoto ? IMAGE_QUALITY.photo : IMAGE_QUALITY.graphic;
const [avif, webp, fallback] = await Promise.all([
  getImage({ src, format: 'avif', widths: finalWidths, quality: q.avif }),
  getImage({ src, format: 'webp', widths: finalWidths, quality: q.webp }),
  isPhoto
    ? getImage({ src, format: 'jpg', widths: finalWidths, quality: IMAGE_QUALITY.photo.jpg })
    : getImage({ src, format: 'png', widths: finalWidths, quality: IMAGE_QUALITY.graphic.png }),
]);
---
<picture>
  <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
  <source type="image/webp" srcset={webp.srcSet.attribute} sizes={sizes} />
  <img src={fallback.src} srcset={fallback.srcSet.attribute} sizes={sizes} alt={alt}
    width={src.width} height={src.height} loading={loading} decoding="async" {...attrs} />
</picture>
