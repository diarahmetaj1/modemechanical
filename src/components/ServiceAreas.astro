---
// Service areas as a large typographic list: each area with some of the neighborhoods served,
// linking to its landing page.
import Icon from './Icon.astro';
import { business } from '../data/site';
import { areas, areaHref } from '../data/areas';
---
<section class="section areas">
  <div class="container">
    <div class="areas__head">
      <h2 data-reveal="fade-up">HVAC Service Areas Across New York City</h2>
      <div data-reveal="fade-up" style="--reveal-delay:.1s">
        <p>Mode Mechanical is based in Brooklyn and provides heating and air conditioning service across New York City — Brooklyn, Queens, the Bronx, Manhattan and Staten Island — as well as Long Island, Westchester County and nearby New Jersey.</p>
        <p>Not sure if you’re in range? Call <a href={business.phoneHref}><strong>{business.phoneDisplay}</strong></a> and we’ll tell you straight away.</p>
      </div>
    </div>
    <ul class="areas__list">
      {areas.map((a, i) => (
        <li data-reveal="fade-up" style={`--reveal-delay:${i * 0.06}s`}>
          <a class:list={['area', { 'area--home': a.home }]} href={areaHref(a)}>
            <span class="area__name">{a.name}</span>
            <span class="area__note">{a.neighborhoods.slice(0, 5).join(', ')} and more</span>
            {a.home ? <span class="area__tag"><Icon name="pin" size={15} /> Home base</span> : <span class="area__go" aria-hidden="true"><Icon name="arrow" size={20} /></span>}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .areas__head { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: end; margin-bottom: 40px; }
  .areas__head h2 { margin: 0; max-width: 14ch; }
  .areas__head p:last-child { margin: 0; }
  .areas__head a { color: var(--cool-deep); }
  .areas__list { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .area { display: grid; grid-template-columns: minmax(200px, 1fr) 1.4fr auto; align-items: center; gap: 24px; padding: 22px 4px; border-bottom: 1px solid var(--line); transition: background-color .3s ease, padding .3s ease; }
  .area:hover { background: var(--paper); padding-inline: 16px; }
  .area:hover .area__name { color: var(--cool); }
  .area__name { transition: color .2s ease; }
  .area__go { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px var(--line); color: var(--ink); transition: background-color .2s ease, color .2s ease, transform .2s ease; }
  .area:hover .area__go { background: var(--ink); color: #fff; transform: translateX(4px); }
  .area__name { font-family: var(--display); font-stretch: 80%; font-weight: 720; font-size: clamp(2rem, 4.6vw, 3.6rem); letter-spacing: -0.035em; line-height: 1; color: var(--ink); }
  .area--home .area__name { color: var(--cool); }
  .area__note { font-size: 1rem; }
  .area__tag { display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 999px; background: var(--ink); color: #fff; font-weight: 700; font-size: .875rem; white-space: nowrap; }
  .area__tag--plain { background: var(--ice); color: var(--cool-deep); }
  @media (max-width: 800px) {
    .areas__head { grid-template-columns: 1fr; gap: 16px; }
    .area { grid-template-columns: 1fr auto; gap: 6px 16px; }
    .area__note { grid-column: 1 / -1; grid-row: 2; }
  }
</style>
