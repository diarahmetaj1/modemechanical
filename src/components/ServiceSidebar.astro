---
import Icon from './Icon.astro';
import { services } from '../data/site';
const path = Astro.url.pathname;
---
<nav class="ssb" aria-label="Services">
  <ul>
    {services.map((s) => (
      <li><a href={s.href} aria-current={path === s.href ? 'page' : undefined}>{s.label}{path === s.href && <Icon name="arrow" />}</a></li>
    ))}
  </ul>
</nav>
<style>
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  a { display: flex; justify-content: space-between; align-items: center; padding: 14px 20px; border-radius: var(--radius-md); background: var(--surface); color: var(--ink); font-size: 1.15rem; font-weight: 500; }
  a:hover { color: var(--blue-500); }
  a[aria-current="page"] { background: var(--blue-500); color: #fff; }
</style>
