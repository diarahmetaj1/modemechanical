---
// Renders nothing until real reviews are added to src/data/testimonials.ts.
import SectionHeading from './SectionHeading.astro';
import { testimonials } from '../data/testimonials';
---
{testimonials.length > 0 && (
  <section class="section">
    <div class="container">
      <SectionHeading pill="Testimonials" title="Our Happy Customers" highlight="Happy" center />
      <ul class="tgrid">
        {testimonials.map((t, i) => (
          <li data-reveal={i % 2 ? 'fade-right' : 'fade-left'}>
            <blockquote>“{t.quote}”</blockquote>
            <p class="tname">{t.name}{t.role && <span>, {t.role}</span>}</p>
            {t.source && <p class="tsrc">via {t.source}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
<style>
  .tgrid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; }
  li { background: var(--surface); border-radius: var(--radius-md); padding: 28px; }
  blockquote { margin: 0 0 16px; color: var(--ink); }
  .tname { font-weight: 600; color: var(--ink); margin: 0; }
  .tsrc { font-size: .85rem; margin: 4px 0 0; }
</style>
