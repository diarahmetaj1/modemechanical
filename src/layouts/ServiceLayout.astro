---
// Shared structure for Installation, Maintenance and Repair:
// banner → sidebar + main content → CTA.
import BaseLayout from './BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import ServiceSidebar from '../components/ServiceSidebar.astro';
import CtaBox from '../components/CtaBox.astro';
import { business } from '../data/site';
import type { PageSeo } from '../data/seo';
interface Props { seo: PageSeo; crumb: string; path: string; lede?: string; extraSchema?: Record<string, unknown>[] }
const { seo, crumb, path, lede, extraSchema } = Astro.props;
---
<BaseLayout seo={seo} breadcrumb={[{ name: crumb, path }]} extraSchema={extraSchema}>
  <PageBanner h1={seo.h1} crumb={crumb} lede={lede} />
  <section class="section">
    <div class="container svc">
      <aside class="svc__aside">
        <ServiceSidebar />
        <div class="svc__help">
          <p class="svc__help-title">No heat or no cooling right now?</p>
          <p>We answer emergency calls around the clock across the five boroughs.</p>
          <a class="svc__help-phone" href={business.phoneHref}>{business.phoneDisplay}</a>
          <a class="btn btn--light" href={business.phoneHref}>Call now</a>
        </div>
      </aside>
      <div class="svc__main prose">
        <slot />
      </div>
    </div>
  </section>
  <CtaBox />
</BaseLayout>
<style>
  .svc { display: grid; grid-template-columns: 280px 1fr; gap: clamp(32px, 5vw, 64px); align-items: start; }
  .svc__aside { position: sticky; top: 110px; display: grid; gap: 24px; }
  .svc__help { position: relative; overflow: hidden; background: var(--ink); color: #B9C7D8; border-radius: var(--radius-lg); padding: 28px; }
  .svc__help::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 4px; background: linear-gradient(90deg, var(--cool), var(--warm)); }
  .svc__help-title { color: #fff; font-family: var(--display); font-stretch: 86%; font-weight: 720; font-size: 1.6rem; line-height: 1.05; letter-spacing: -0.02em; margin-bottom: 10px; }
  .svc__help-phone { display: block; margin: 6px 0 4px; color: #fff; font-family: var(--display); font-stretch: 86%; font-weight: 720; font-size: 2rem; letter-spacing: -0.02em; }
  .svc__help .btn { width: 100%; margin-top: 8px; }
  .svc__main :global(h2) { max-width: 24ch; }
  .svc__main :global(section + section) { margin-top: clamp(48px, 7vw, 80px); }
  @media (max-width: 900px) {
    .svc { grid-template-columns: 1fr; }
    .svc__aside { position: static; order: 2; }
  }
</style>
