---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import ServiceAreas from '../../components/ServiceAreas.astro';
import CtaBox from '../../components/CtaBox.astro';
import { seo } from '../../data/seo';
---
<BaseLayout seo={seo.areas} breadcrumb={[{ name: 'Service Areas', path: '/areas/' }]}>
  <PageBanner h1={seo.areas.h1} crumb="Service Areas" lede="Based in Brooklyn, working across New York City, Long Island and Westchester County." />
  <ServiceAreas />
  <CtaBox />
</BaseLayout>
