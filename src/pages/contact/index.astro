---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import ContactForm from '../../components/islands/ContactForm';
import Icon from '../../components/Icon.astro';
import { seo } from '../../data/seo';
import { business, profiles } from '../../data/site';
import { areas } from '../../data/areas';
---
<BaseLayout seo={seo.contact} breadcrumb={[{ name: 'Contact', path: '/contact/' }]}>
  <PageBanner h1={seo.contact.h1} crumb="Contact" lede="Call, email or send a message — emergencies are answered 24/7." />
  <section class="section">
    <div class="container contact">
      <div class="contact__info">
        <h2 class="visually-hidden">Contact details</h2>
        <p class="contact__intro" data-reveal="fade-up">Have a question or need HVAC services? We’re here to help! Fill out the form, and one of our expert technicians will get back to you as soon as possible. Whether it’s a quick inquiry, service request, or free estimate, we’re ready to assist with all your heating and cooling needs.</p>
        <ul>
          <li data-reveal="fade-left" style="--reveal-delay:0s"><Icon name="clock" size={22} /><div><h3>Opening Hours</h3><p>{business.hours}</p></div></li>
          <li data-reveal="fade-left" style="--reveal-delay:0.2s"><Icon name="pin" size={22} /><div><h3>Service Area</h3><address>Based in {business.base.city}, {business.base.region} {business.base.zip}</address><p>We come to you across {areas.map((ar, i) => <>{i > 0 && (i === areas.length - 1 ? ' and ' : ', ')}<a href={`/areas/${ar.slug}/`}>{ar.name}</a></>)}.</p></div></li>
          <li data-reveal="fade-left" style="--reveal-delay:0.4s"><Icon name="mail" size={22} /><div><h3>Email Us</h3><a href={`mailto:${business.email}`}>{business.email}</a></div></li>
          <li data-reveal="fade-left" style="--reveal-delay:0.6s"><Icon name="phone" size={22} /><div><h3>Call Us Directly</h3><a href={business.phoneHref}>{business.phoneTopbar}</a></div></li>
        </ul>
        {profiles.length > 0 && (
          <div class="contact__profiles" data-reveal="fade-up">
            <h3>Read our reviews</h3>
            <div>{profiles.map((pr) => <a class="btn btn--ink" href={pr.href} target="_blank" rel="noopener"><Icon name="star" size={18} /> {pr.cta}</a>)}</div>
          </div>
        )}
      </div>
      <div class="contact__form" data-reveal="fade-right">
        <h2 class="visually-hidden">Send us a message</h2>
        <ContactForm client:visible phone={business.phoneDisplay} phoneHref={business.phoneHref} email={business.email} />
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .contact { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(32px, 6vw, 72px); align-items: start; }
  .contact__intro { font-size: 1.05rem; }
  ul { list-style: none; margin: 28px 0 0; padding: 0; display: grid; gap: 18px; }
  li { display: flex; gap: 16px; align-items: flex-start; }
  li :global(svg) { flex: none; color: var(--blue-500); margin-top: 4px; }
  h3 { font-size: 1.1rem; margin: 0 0 2px; }
  li p, address { margin: 0; font-style: normal; }
  .contact__profiles { margin-top: 32px; }
  .contact__profiles > div { display: flex; flex-wrap: wrap; gap: 12px; }
  .contact__profiles :global(svg) { color: #FBBF24; fill: currentColor; margin: 0; }
  li a { color: var(--blue-800); font-weight: 600; }
  .contact__form { background: #fff; border-radius: var(--radius-lg); padding: clamp(24px, 4vw, 40px); box-shadow: 0 18px 50px rgba(15,35,56,.08); }
  @media (max-width: 900px) { .contact { grid-template-columns: 1fr; } }
</style>
