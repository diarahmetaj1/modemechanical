---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import FaqAccordion from '../../components/islands/FaqAccordion';
import { seo } from '../../data/seo';
import { miniSplitTypes, miniSplitBenefits } from '../../data/features';
import { miniSplitFaq } from '../../data/faq';
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: miniSplitFaq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<ServiceLayout seo={seo.miniSplits} crumb="Ductless Mini-Splits" path="/ductless-mini-splits/" lede="Quiet, efficient heating and cooling for brownstones, apartments, additions and offices — no ductwork required." extraSchema={[faqSchema]}>
  <section>
    <SectionHeading title="Ductless Mini-Splits for New York Homes and Businesses" highlight="Mini-Splits">
      <p>Most New York buildings were never built for central air. Ductless mini-splits solve that: an outdoor unit on the roof, yard or wall connects to slim indoor units through a small refrigerant line, so each room gets its own quiet, efficient heating and cooling.</p>
      <p>Mode Mechanical designs and installs single-zone and multi-zone systems across Brooklyn, Queens, Manhattan, the Bronx, Staten Island, Long Island and Westchester. We plan where every unit goes, how the lines and drains are routed, and how the system is powered before any work starts — and you get a written price up front.</p>
    </SectionHeading>
    <img class="ms__img" src="/images/specialty-2.jpg" alt="Mode Mechanical technician working on a ductless mini-split system" width="600" height="450" loading="lazy" decoding="async" data-reveal="fade-up" />
  </section>

  <section>
    <h2>Why Choose a Ductless System</h2>
    <FeatureGrid items={miniSplitBenefits} cols={2} />
  </section>

  <section>
    <h2>Indoor Unit Styles</h2>
    <p>One outdoor unit can power several different indoor styles, so every room gets the unit that suits it.</p>
    <FeatureGrid items={miniSplitTypes} cols={2} />
  </section>

  <section>
    <BrandLogos boxed title="Mini-Split Brands We Install" />
  </section>

  <section>
    <h2>Ductless Mini-Split Questions</h2>
    <FaqAccordion client:visible items={miniSplitFaq} />
  </section>
</ServiceLayout>
<style>
  .ms__img { width: 100%; max-height: 420px; object-fit: cover; border-radius: var(--radius-lg); }
</style>
