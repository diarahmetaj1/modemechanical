---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import { seo } from '../../data/seo';
import { maintenanceFeatures } from '../../data/features';
---
<ServiceLayout seo={seo.maintenance} crumb="HVAC Maintenance" path="/hvac-maintenance/" lede="One visit a year keeps your system efficient, your warranty valid and your January free of emergency calls.">
  <section>
    <SectionHeading title="Annual HVAC Maintenance for Homes and Businesses in Brooklyn" highlight="Maintenance">
      <p>An annual tune-up is the cheapest way to avoid an emergency call in January. Mode Mechanical services air conditioners, furnaces, boilers and heat pumps across Brooklyn, Queens, Manhattan and the Bronx — cleaning coils, checking refrigerant, testing controls and clearing drain lines so your system runs efficiently through the season ahead.</p>
    </SectionHeading>
    <BrandLogos boxed slider={false} title="" />
  </section>

  <section>
    <h2>Why Choose Us for HVAC Maintenance</h2>
    <FeatureGrid items={maintenanceFeatures} cols={2} />
  </section>
</ServiceLayout>
