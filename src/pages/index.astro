---
import BaseLayout from '../layouts/BaseLayout.astro';
import TempHero from '../components/TempHero.astro';
import FaqAccordion from '../components/islands/FaqAccordion';
import SectionHeading from '../components/SectionHeading.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Stats from '../components/Stats.astro';
import Testimonials from '../components/Testimonials.astro';
import BrandLogos from '../components/BrandLogos.astro';
import ServiceAreas from '../components/ServiceAreas.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import welcomeImg from '../assets/photos/welcome.jpg';
import specialtyImg from '../assets/photos/specialty-1.jpg';
import maintenanceImg from '../assets/photos/service-maintenance.jpg';
import installImg from '../assets/projects/project-01.jpg';
import repairImg from '../assets/projects/project-02.jpg';
import bulkheadImg from '../assets/projects/project-05.jpg';
import supportImg from '../assets/photos/faq-support.jpg';
import { seo } from '../data/seo';
import { whyChooseHome } from '../data/features';
import { homeFaq } from '../data/faq';
import { business, bookingUrl } from '../data/site';

const page = seo.home;
const serviceCards = [
  { title: 'Installation', href: '/hvac-installation/', image: installImg,
    alt: 'HVAC installation in Brooklyn: new outdoor condensers on a flat rooftop',
    text: 'New central AC, furnaces, boilers, heat pumps and ductless mini-splits — sized for your building, permitted and installed to code.' },
  { title: 'Repair', href: '/hvac-repair/', image: repairImg,
    alt: 'HVAC repair on a Manhattan rooftop, two outdoor units with service panels open',
    text: 'AC not cooling or heat not working? Licensed technicians, 24/7 emergency response across the five boroughs, and a price before the work starts.' },
  { title: 'Maintenance', href: '/hvac-maintenance/', image: maintenanceImg,
    alt: 'Mitsubishi outdoor units on a city rooftop, ready for seasonal HVAC maintenance',
    text: 'Annual tune-ups that catch problems before they become emergency calls — and keep your manufacturer warranty valid.' },
];
const steps = [
  { title: 'Consultation', icon: 'chat' },
  { title: 'Agreement', icon: 'handshake' },
  { title: 'Execution', icon: 'wrench' },
  { title: 'Quality Check', icon: 'clipboardCheck' },
] as const;
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: homeFaq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<BaseLayout seo={page} extraSchema={[faqSchema]}>
  <TempHero h1={page.h1} />

  <section class="section">
    <div class="container split">
      <Photo class="split__img" data-reveal="scale-in" src={welcomeImg} alt="Row of new LG outdoor condensers on a rooftop, gauges connected during AC installation"
        sizes="(max-width: 900px) calc(100vw - 36px), 580px" />
      <div>
        <SectionHeading pill="Welcome" title="Brooklyn Air Conditioning and Heating Specialists" highlight="Heating">
          <p>Mode Mechanical is a licensed HVAC company based in Brooklyn, NY, providing air conditioning and heating service across <a href="/service-areas/">New York City, Long Island and Westchester</a>. From <a href="/hvac-installation/">AC and heating installation</a> to <a href="/hvac-repair/">furnace, boiler and AC repair</a> and <a href="/hvac-maintenance/">seasonal maintenance</a>, we deliver fast, reliable solutions to keep your home or business comfortable year-round.</p>
          <p><strong>Choose Mode Mechanical for efficient, affordable HVAC in Brooklyn.</strong></p>
        </SectionHeading>
        <a class="btn btn--primary" href="/about-us/">About Company</a>
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="svc-head">
        <h2 data-reveal="fade-up">HVAC Services for Every Season</h2>
        <p data-reveal="fade-up" style="--reveal-delay:.1s">At Mode Mechanical, we provide comprehensive HVAC solutions designed to keep your home or business comfortable year-round — repairs, new systems and yearly tune-ups across New York City.</p>
      </div>
      <div class="bento">
        <a class="tile tile--repair" href="/hvac-repair/" data-reveal="fade-up">
          <Photo class="tile__img" src={serviceCards[1].image} alt={serviceCards[1].alt} sizes="(max-width: 900px) 100vw, 600px" />
          <span class="tile__body">
            <span class="tile__kicker">24/7 emergency service</span>
            <h3>Repair</h3>
            <span class="tile__text">{serviceCards[1].text}</span>
            <span class="tile__chips">
              <span class="chip chip--cool">AC not cooling</span><span class="chip chip--warm">No heat</span>
              <span class="chip">Strange noises</span><span class="chip chip--cool">Frozen coils</span><span class="chip chip--warm">Uneven rooms</span>
            </span>
            <span class="tile__go">Find your problem <Icon name="arrow" size={18} /></span>
          </span>
        </a>
        <a class="tile tile--install" href="/hvac-installation/" data-reveal="fade-up" style="--reveal-delay:.1s">
          <span class="tile__body">
            <h3>Installation</h3>
            <span class="tile__text">{serviceCards[0].text}</span>
            <span class="tile__go">Plan a new system <Icon name="arrow" size={18} /></span>
          </span>
          <Photo class="tile__thumb" src={serviceCards[0].image} alt={serviceCards[0].alt} widths={[400, 800]} sizes="(max-width: 900px) 100vw, 400px" />
        </a>
        <a class="tile tile--maint" href="/hvac-maintenance/" data-reveal="fade-up" style="--reveal-delay:.2s">
          <span class="tile__body">
            <h3>Maintenance</h3>
            <span class="tile__text">{serviceCards[2].text}</span>
            <span class="tile__go">Book a tune-up <Icon name="arrow" size={18} /></span>
          </span>
          <Photo class="tile__thumb" src={serviceCards[2].image} alt={serviceCards[2].alt} widths={[400, 800]} sizes="(max-width: 900px) 100vw, 400px" />
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading pill="Top 6 Reasons" title="Why Choose Mode Mechanical" highlight="Choose" center>
        <p>At Mode Mechanical, we deliver top-rated HVAC services in Brooklyn with a focus on reliability, affordability, and expert care. Our licensed technicians provide fast air conditioning repair, heating installation, and energy-efficient HVAC solutions for homes and businesses.</p>
        <p><strong>Quality service. Trusted experts. Local HVAC you can count on.</strong></p>
      </SectionHeading>
      <FeatureGrid items={whyChooseHome} />
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <SectionHeading pill="Services Process" title="How Our HVAC Service Works" highlight="Works" center>
        <p>Our process is simple and reliable for all your HVAC needs in Brooklyn. It starts with a personalized consultation where we assess your space and recommend the best heating and cooling solutions. Once we finalize the details, our licensed HVAC technicians in NYC get to work using top-quality equipment and proven methods. We finish with a complete system inspection and quality check, ensuring your air conditioning or heating system is running efficiently and safely.</p>
      </SectionHeading>
      <ol class="steps">
        {steps.map((s, i) => <li data-reveal="fade-right" style={`--reveal-delay:${(i + 1) * 0.2}s`}><span class="steps__icon"><Icon name={s.icon} size={28} /></span><span class="steps__n">Step {i + 1}</span><h3>{s.title}</h3></li>)}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container split split--wide">
      <div>
        <SectionHeading pill="Our Specialty" title="Heating and Cooling Solutions for Brooklyn Homes and Businesses" highlight="Heating">
          <p>Welcome to Mode Mechanical, your trusted partner for all your HVAC needs. With years of industry experience and a commitment to excellence, we specialize in providing top-quality heating and air conditioning services tailored to your unique requirements. From installation and repair to maintenance and upgrades, our skilled technicians are dedicated to delivering reliable solutions that ensure your comfort and satisfaction.</p>
        </SectionHeading>
      </div>
      <div class="mosaic">
        <Photo src={specialtyImg} data-reveal="scale-in" alt="Two mini-split heat pump condensers on ground stands beside a house" widths={[400, 800]} sizes="(max-width: 900px) 50vw, 300px" />
        <Stats />
        <Photo src={bulkheadImg} data-reveal="scale-in" alt="Ductless mini-split outdoor units installed beside a Manhattan rooftop bulkhead" widths={[400, 800]} sizes="(max-width: 900px) 50vw, 300px" />
      </div>
    </div>
  </section>

  <Testimonials />

  <section class="section section--surface">
    <div class="container split">
      <div class="faq-aside">
        <Photo src={supportImg} data-reveal="zoom-in" alt="Smiling customer service agent with a headset answering an HVAC service call, 24/7" widths={[350]} sizes="(max-width: 900px) 100vw, 550px" />
        <a class="faq-aside__phone" href={business.phoneHref}>
          <span>24 Hours &amp; Emergencies</span>
          <strong><Icon name="phone" size={22} /> {business.phoneTopbar}</strong>
        </a>
      </div>
      <div>
        <SectionHeading pill="FAQ" title="HVAC Questions, Answered" highlight="Questions" />
        <div data-reveal="slide-up"><FaqAccordion client:visible items={homeFaq} /></div>
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container"><BrandLogos /></div>
  </section>

  <ServiceAreas />
</BaseLayout>

<style>
  .svc-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; margin-bottom: 48px; }
  .svc-head h2 { max-width: 12ch; margin: 0; }
  .svc-head p { max-width: 46ch; margin: 0; font-size: 1.1rem; }
  .bento { display: grid; grid-template-columns: 1.2fr 1fr; grid-template-rows: 1fr 1fr; gap: 20px; }
  .tile { position: relative; display: flex; border-radius: var(--radius-lg); overflow: hidden; color: var(--ink); transition: transform .35s ease, box-shadow .35s ease; }
  .tile:hover { transform: translateY(-4px); box-shadow: var(--shadow-lift); }
  .tile h3 { font-size: clamp(2rem, 3.4vw, 2.9rem); letter-spacing: -0.03em; margin: 0 0 10px; }
  .tile__text { display: block; max-width: 40ch; }
  .tile__go { margin-top: auto; padding-top: 22px; display: inline-flex; align-items: center; gap: 8px; font-weight: 700; }
  .tile__go :global(svg) { transition: transform .2s ease; }
  .tile:hover .tile__go :global(svg) { transform: translateX(4px); }
  .tile__body { position: relative; display: flex; flex-direction: column; padding: clamp(24px, 3vw, 40px); flex: 1; }

  .tile--repair { grid-row: span 2; background: var(--ink); color: #fff; min-height: 560px; }
  .tile--repair h3 { color: #fff; }
  .tile--repair .tile__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .38; transition: transform .8s ease, opacity .4s ease; }
  .tile--repair:hover .tile__img { transform: scale(1.04); opacity: .45; }
  .tile--repair::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(14,34,56,.2) 0%, rgba(14,34,56,.92) 70%); }
  .tile--repair .tile__body { z-index: 1; justify-content: flex-end; }
  .tile--repair .tile__text { color: #C9D5E4; }
  .tile__kicker { display: inline-block; align-self: flex-start; margin-bottom: auto; padding: 8px 14px; border-radius: 999px; background: rgba(255,255,255,.12); font-weight: 700; font-size: .9rem; }
  .tile__chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
  .chip { font-size: .9rem; font-weight: 650; padding: 8px 14px; border-radius: 999px; background: rgba(255,255,255,.1); box-shadow: inset 0 0 0 1px rgba(255,255,255,.16); }
  .chip--cool { background: rgba(44,107,224,.35); }
  .chip--warm { background: rgba(194,65,12,.4); }

  .tile--install { background: var(--ice); }
  .tile--maint { background: var(--blush); }
  .tile--install .tile__go { color: var(--cool-deep); }
  .tile--maint .tile__go { color: var(--ember); }
  .tile__thumb { width: 36%; object-fit: cover; flex: none; transition: transform .8s ease; }
  .tile:hover .tile__thumb { transform: scale(1.05); }

  @media (max-width: 900px) {
    .svc-head { flex-direction: column; align-items: flex-start; gap: 16px; }
    .bento { grid-template-columns: 1fr; grid-template-rows: auto; }
    .tile--repair { grid-row: auto; min-height: 520px; }
  }
  @media (max-width: 560px) { .tile__thumb { display: none; } }

  .split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .split--wide { grid-template-columns: 1fr 1.1fr; }
  .split__img { border-radius: var(--radius-lg); width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }

  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .card { background: #fff; border-radius: var(--radius-lg); overflow: hidden; display: flex; flex-direction: column; }
  .card img { width: 100%; aspect-ratio: 10 / 7; object-fit: cover; }
  .card__body { padding: 24px 26px 28px; display: flex; flex-direction: column; flex: 1; }
  .card h3 a:hover { color: var(--blue-500); }
  .card__more { margin-top: auto; display: inline-flex; align-items: center; gap: 6px; color: var(--blue-800); font-weight: 600; }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; counter-reset: none; }
  .steps li { background: #fff; border-radius: var(--radius-md); padding: 26px 22px; text-align: center; }
  .steps__icon { width: 64px; height: 64px; margin: 0 auto 14px; border-radius: 50%; background: var(--blue-800); color: #fff; display: grid; place-items: center; }
  .steps li:nth-child(even) .steps__icon { background: var(--blue-400); }
  .steps__n { display: block; color: var(--blue-500); font-weight: 600; margin-bottom: 6px; }
  .steps h3 { margin: 0; }

  .mosaic { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; align-items: center; }
  .mosaic img { border-radius: var(--radius-md); width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .mosaic :global(.stats) { grid-row: span 2; }

  .faq-aside { position: relative; }
  .faq-aside img { border-radius: var(--radius-lg); width: 100%; aspect-ratio: 6 / 7; object-fit: cover; object-position: 50% 30%; }
  .faq-aside__phone { position: absolute; left: 24px; right: 24px; bottom: 24px; background: var(--blue-800); color: #fff; border-radius: var(--radius-md); padding: 18px 22px; display: grid; gap: 4px; }
  .faq-aside__phone strong { display: inline-flex; align-items: center; gap: 10px; font-size: 1.5rem; }

  @media (max-width: 900px) {
    .split, .split--wide { grid-template-columns: 1fr; }
    .cards { grid-template-columns: 1fr; max-width: 520px; margin-inline: auto; }
    .steps { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) { .mosaic { grid-template-columns: 1fr; } .steps { grid-template-columns: 1fr; } }
</style>
