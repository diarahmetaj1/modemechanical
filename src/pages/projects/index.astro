---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import ProjectGallery from '../../components/islands/ProjectGallery';
import { seo } from '../../data/seo';
import { getImage } from 'astro:assets';
import { projects } from '../../data/projects';
import type { GalleryProject } from '../../components/islands/ProjectGallery';

// Each photo is turned into AVIF and WebP at several widths, plus a JPEG fallback, at build time.
// In-between sizes let high-density phones pick a file close to what the slot needs.
const WIDTHS = [400, 480, 600, 720, 800, 1200, 1600];
const prepared: GalleryProject[] = await Promise.all(projects.map(async (p) => ({
  slug: p.slug, title: p.title, location: p.location, description: p.description,
  photos: await Promise.all(p.photos.map(async ({ src, alt, position }) => {
    const widths = [...WIDTHS.filter((w) => w < src.width), Math.min(src.width, 1600)];
    const [avif, webp, jpg] = await Promise.all([
      // Per-format quality, matching Photo.astro: AVIF 42 looks the same as 50 here and is ~25% smaller.
      getImage({ src, format: 'avif', widths, quality: 42 }),
      getImage({ src, format: 'webp', widths, quality: 72 }),
      getImage({ src, format: 'jpg', width: Math.min(src.width, 1200), quality: 78 }),
    ]);
    return { avif: avif.srcSet.attribute, webp: webp.srcSet.attribute, src: jpg.src, width: src.width, height: src.height, alt, position };
  })),
})));
const photoTotal = projects.reduce((n, p) => n + p.photos.length, 0);
---
<BaseLayout seo={seo.projects} breadcrumb={[{ name: 'Projects', path: '/projects/' }]}>
  <PageBanner h1={seo.projects.h1} crumb="Projects" lede="Recent HVAC installations, service calls and ductwork across Brooklyn, Manhattan and NYC." />
  <section class="section">
    <div class="container">
      <p class="intro" data-reveal="fade-up">{projects.length} recent HVAC jobs by Mode Mechanical, {photoTotal} photos: rooftop condensers and VRF service, ductless mini-splits and ceiling cassettes, a gas furnace, commercial ductwork and refrigeration service. Planning something similar? See our <a href="/hvac-installation/">HVAC installation</a> and <a href="/hvac-repair/">HVAC repair</a> services.</p>
      <ProjectGallery client:visible projects={prepared} />
    </div>
  </section>
</BaseLayout>
<style>
  .intro { max-width: 70ch; margin: 0 auto 40px; text-align: center; font-size: 1.05rem; }
  .intro a { color: var(--cool-deep); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
</style>
