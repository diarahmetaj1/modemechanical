{
  "trailingSlash": true,
  "functions": {
    "api/assistant.ts": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/services",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cart",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/checkout",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/my-account",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sitemap_index.xml",
      "destination": "/sitemap-index.xml",
      "permanent": true
    },
    {
      "source": "/installation",
      "destination": "/hvac-installation/",
      "permanent": true
    },
    {
      "source": "/maintenance",
      "destination": "/hvac-maintenance/",
      "permanent": true
    },
    {
      "source": "/repair",
      "destination": "/hvac-repair/",
      "permanent": true
    },
    {
      "source": "/ductless-mini-splits",
      "destination": "/hvac-installation/",
      "permanent": true
    },
    {
      "source": "/heat-pumps",
      "destination": "/hvac-installation/",
      "permanent": true
    },
    {
      "source": "/areas",
      "destination": "/service-areas/",
      "permanent": true
    },
    {
      "source": "/areas/brooklyn",
      "destination": "/hvac-brooklyn-ny/",
      "permanent": true
    },
    {
      "source": "/areas/queens",
      "destination": "/hvac-queens-ny/",
      "permanent": true
    },
    {
      "source": "/areas/manhattan",
      "destination": "/hvac-manhattan-ny/",
      "permanent": true
    },
    {
      "source": "/areas/bronx",
      "destination": "/hvac-bronx-ny/",
      "permanent": true
    },
    {
      "source": "/areas/staten-island",
      "destination": "/hvac-staten-island-ny/",
      "permanent": true
    },
    {
      "source": "/areas/long-island",
      "destination": "/hvac-long-island-ny/",
      "permanent": true
    },
    {
      "source": "/areas/westchester",
      "destination": "/hvac-westchester-ny/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/(llms|llms-full).txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
